# Backend-only. JANGAN pakai prefix NEXT_PUBLIC_ pada kredensial.
DATABASE_URL="postgresql://gallery:CHANGE_ME@localhost:5433/gallery?schema=public"
REDIS_URL="redis://localhost:6379"
IMMICH_URL="http://192.168.100.10:2283"
IMMICH_API_KEY="YOUR_IMMICH_SERVICE_ACCOUNT_API_KEY"
# auto = modern v3.2+ jika deteksi versi berhasil; fallback legacy untuk v3.0-v3.1
IMMICH_SEARCH_MODE="auto"
GALLERY_CACHE_ROOT="./.gallery-cache"
# Base URL untuk QR event; hanya digunakan pembuatan link, bukan autentikasi.
GALLERY_PUBLIC_URL="https://foto.example.com"
